# --- App ---
APP_ENV=dev
SECRET_KEY=change-me-in-production
TOKEN_TTL_HOURS=8

# --- LLM (OpenAI 兼容协议) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60

# --- 元数据库 (SQLite) ---
META_DB_URL=sqlite:///./data/meta.db

# --- 敏感对象黑名单（逗号分隔关键词，用于列名/注释过滤） ---
SENSITIVE_KEYWORDS=password,token,secret,api_key,access_key,private_key,id_card,credit_card
